{
    "name": "rrze-notices",
    "version": "4.0.0",
    "description": "Dashboard notices for WordPress Multisite with role-based visibility.",
    "license": "GPL-3.0-or-later",
    "private": true,
    "engines": {
        "node": ">=20",
        "npm": ">=10"
    },
    "repository": {
        "type": "git",
        "url": "https://github.com/RRZE-Webteam/rrze-notices"
    },
    "author": {
        "name": "RRZE-Webteam",
        "email": "webmaster@fau.de",
        "url": "https://www.wordpress.rrze.fau.de"
    },
    "compatibility": {
        "wprequires": "6.5",
        "wptestedup": "7.1.3",
        "phprequires": "8.2"
    },
    "devDependencies": {
        "@wordpress/scripts": "latest"
    },
    "browserslist": [
        "extends @wordpress/browserslist-config"
    ],
    "scripts": {
        "start": "wp-scripts start",
        "build": "wp-scripts build",
        "format": "wp-scripts format src",
        "lint:js": "wp-scripts lint-js src",
        "check-engines": "wp-scripts check-engines",
        "check-licenses": "wp-scripts check-licenses --prod --gpl3",
        "packages-update": "wp-scripts packages-update"
    }
}